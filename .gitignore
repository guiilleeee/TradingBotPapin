*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.hl_leaderboard_cache.json
symbols.yaml.tmp
# backtest.db and backtest_historical_screening.db are local, ad-hoc
# evaluation artifacts (the latter is normally produced by a GitHub Actions
# run and downloaded as a build artifact, not committed), unlike
# trading_bot.db/signals.csv which ARE the live system's real audit trail
# and are deliberately tracked -- see the note below.
backtest.db
backtest_historical_screening.db
historical_screening_trades.csv
.DS_Store

# NOTE: do NOT add a blanket *.csv or *.db rule here. A blanket ignore silently
# broke the dashboard publishing step in an earlier version -- the Actions commit
# step copies signals.csv into docs/ and the push simply dropped it, with no error.
# If a blanket rule is ever wanted, add targeted exceptions alongside it:
#   *.csv
#   !signals.csv
#   !docs/*.csv
