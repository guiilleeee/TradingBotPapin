# Copy to /opt/tradingbot/.env and fill in. Same names as the GitHub secrets.
# .env is gitignored -- never commit the filled-in copy. Then: chmod 600 .env

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Uncomment to rehearse against Alpaca paper trading with live_execution: true.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
FMP_API_KEY=
# Telegram alerts. See "3b. Telegram" in deploy/README.md.
# The bot token controls the bot -- treat it like a password.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web Push to the dashboard (alongside Telegram). Generated by
#   .venv/bin/python web_push.py setup     -- see "3c. Web Push" in deploy/README.md.
VAPID_PRIVATE_KEY=
PUSH_SUBSCRIPTION_KEY=
# Contact address the push services may use (sent as "mailto:<this>" in every
# push's VAPID claim), e.g. VAPID_ADMIN_EMAIL=you@example.com
# Left empty, the bot falls back to https://guiilleeee.github.io.
VAPID_ADMIN_EMAIL=

# 1 = commit + push results so the GitHub Pages dashboard stays live.
PUBLISH=1
