# Copy to /opt/tradingbot/.env and fill in. Same names as the GitHub secrets.
# .env is gitignored -- never commit the filled-in copy. Then: chmod 600 .env

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Uncomment to rehearse against Alpaca paper trading with live_execution: true.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
FMP_API_KEY=
# Phone push (alerts + approval_mode). NTFY_TOPIC is the password on the public
# ntfy.sh server. Generate it with:   echo tb-$(openssl rand -hex 16)
# and paste the SAME value here, in the GitHub secret, and in the ntfy app.
# Topics under 24 characters are refused by the bot.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# 1 = commit + push results so the GitHub Pages dashboard stays live.
PUBLISH=1
